#!/bin/bash
#PBS -N bms_dw4
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o bms_dw4.log

cd $PBS_O_WORKDIR

module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

# src-layout package; the BMS env does not install this repo.
export PYTHONPATH="${PBS_O_WORKDIR}/src${PYTHONPATH:+:$PYTHONPATH}"

# Trainer extras not present in the adjoint_samplers BMS environment.yml.
python - <<'PY'
import importlib, subprocess, sys
missing = []
for mod, pkg in (("lightning", "lightning"), ("tqdm", "tqdm")):
    try:
        importlib.import_module(mod)
    except ImportError:
        missing.append(pkg)
if missing:
    subprocess.check_call([sys.executable, "-m", "pip", "install", *missing])
PY

python -u -m bms.experiment.train experiment=dw4 seed=0
